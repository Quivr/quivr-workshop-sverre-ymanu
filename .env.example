# Anthropic API key for your group (given on the day). Used by the agent, evals and OpenCode.
ANTHROPIC_API_KEY=

# Models the chat may use, as provider:model ids. The first is a fast, cheap default; the second a stronger one to compare.
ALLOWED_MODELS=anthropic:claude-haiku-5-5,anthropic:claude-sonnet-5-5
# Model used when the request doesn't pick one. Must be in ALLOWED_MODELS.
DEFAULT_MODEL=anthropic:claude-haiku-5-5
# Model used by the LLM-as-judge scorer in the evals.
JUDGE_MODEL=anthropic:claude-haiku-5-5

# live = call the real Quivr backend, fixtures = recorded, anonymised data (no login needed, clock frozen at recording time).
QUIVR_MODE=live
# true = the MCP server refuses every GraphQL mutation. Set to false only to really send invites.
QUIVR_READ_ONLY=true
# Quivr backend URL. Beta by default (accounts at https://alpha.quivr.be). Production: https://rails.quivr.be
QUIVR_BASE_URL=https://rails-beta.quivr.be
# true = also expose the experimental run_graphql_query tool (any read-only query, live mode only). See docs/generic-graphql.md.
ENABLE_GENERIC_GRAPHQL=false

# Filled in by `just login`, cleared by `just logout`. Never commit these.
QUIVR_AUTHORIZATION=
QUIVR_UID=
QUIVR_CLIENT=
QUIVR_ACCESS_TOKEN=

# Time zone used for "today" in the prompt and the UI.
TZ_DISPLAY=Europe/Brussels
